<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE DataType SYSTEM "../LibraryElement.dtd">
<DataType Namespace="Main" Name="InterlockRule" Comment="One term of one interlock alternative. TermCount&gt;=1 heads an alternative and counts its terms; 0 continues the one above.">
  <Identification Standard="1131-3" />
  <VersionInfo Organization="WMG" Version="0.1" Author="easensoy" Date="5/24/2026" Remarks="array-of-struct packaging of the 4 Rule arrays" />
  <CompilerInfo />
  <StructuredType>
    <VarDeclaration Name="FromState" Type="INT" />
    <VarDeclaration Name="ToState" Type="INT" />
    <VarDeclaration Name="SourceID" Type="INT" />
    <VarDeclaration Name="BlockedState" Type="INT" />
    <VarDeclaration Name="TermCount" Type="INT" />
  </StructuredType>
</DataType>